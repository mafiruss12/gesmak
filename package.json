{
  "name": "stock-manager-ai",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "cap:add": "npx cap add android",
    "android:apk": "bash scripts/build-apk.sh",
    "android:release": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "build:mobile": "VITE_BASE=./ vite build",
    "android:open": "npx cap open android",
    "perms:note": "echo \"npm i @capacitor/geolocation @capacitor/camera @capacitor/local-notifications && npx cap sync android\"",
    "android:perms": "bash scripts/inject-android-permissions.sh"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/network": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "@supabase/supabase-js": "^2.57.4",
    "@tiun/sdk": "^0.9.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "tesseract.js": "^5.1.1",
    "@capacitor/push-notifications": "^6.0.2",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
